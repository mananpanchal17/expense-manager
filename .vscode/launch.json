{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Expense Manager",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
